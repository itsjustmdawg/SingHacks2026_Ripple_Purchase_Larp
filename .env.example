# Copy this file to .env.local. Never commit .env.local or any real credentials.
# Use XRPL Testnet during hackathon development. Do not use production/mainnet
# credentials or wallet seeds during early development.

# Required for Gemini-powered Market Scout and Deal Analyst agents.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Leave RPC empty for the official Testnet endpoint. A blank seed creates a
# temporary wallet locally. Hosting MUST use a persistent Testnet wallet seed
# so wallet display and payment functions use the same account.
XRPL_NETWORK=testnet
XRPL_RPC_URL=
XRPL_WALLET_SEED=

POLICY_PRINCIPAL_ID=development-user
POLICY_SPENDING_ENABLED=true
POLICY_TRANSACTION_LIMIT_XRP=10
POLICY_REMAINING_BUDGET_XRP=25
POLICY_APPROVAL_THRESHOLD_XRP=5

# Shared hackathon login (server-only). Generate a random AUTH_SECRET of at least
# 32 characters. Configure these in .env.local and Vercel Production settings.
AUTH_SECRET=
DEMO_LOGIN_EMAIL=demo@purchaselarp.app
DEMO_LOGIN_PASSWORD=
