# Copy this file to .env.local. Never commit .env.local or any real credentials.
# Use XRPL Testnet during hackathon development. Do not use production/mainnet
# credentials or wallet seeds during early development.

LLM_API_KEY=
XRPL_NETWORK=testnet
XRPL_RPC_URL=
XRPL_WALLET_SEED=

